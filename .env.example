# Copy to backend/.env (or repo-root .env) and adjust. All values optional —
# the app runs fully offline with sensible defaults and a mock billing provider.

# --- Environment ---
ENVIRONMENT=development

# --- Persistence (defaults to %LOCALAPPDATA%/spamsms/spamsms.db on Windows) ---
# DATABASE_PATH=./spamsms.db

# --- Entitlements ---
ANONYMOUS_GRACE_LIMIT=10
TRIAL_DAYS=14
TRIAL_ANALYSES=200
MAX_SCAN_ROWS=10000
# MAX_SCAN_BYTES=2097152          # 2 MiB CSV body cap
# RATE_LIMIT_PER_MINUTE=60        # token bucket per IP+user

# --- CORS (leave empty for same-origin / Vite-proxy dev; set for split hosting) ---
# CORS_ORIGINS=["http://localhost:5173"]

# --- Stripe (OPTIONAL). Leave unset to use the offline MockProvider. ---
# When STRIPE_SECRET_KEY is set, billing switches to real Stripe Checkout.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_ID=price_xxx
# FRONTEND_ORIGIN=http://localhost:5173

# --- Force a billing provider regardless of keys (dev/testing) ---
# BILLING_PROVIDER_OVERRIDE=mock
